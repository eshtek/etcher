{
  "name": "hexos-imager",
  "private": true,
  "displayName": "HexOS Imager",
  "productName": "HexOS Imager",
  "version": "2.1.9",
  "packageType": "local",
  "main": ".webpack/main",
  "description": "Download, verify, and flash HexOS to USB drives, safely and easily.",
  "productDescription": "HexOS Imager downloads the latest HexOS installer, verifies its checksum, and flashes it to a USB drive so you can install HexOS on your server. It protects you from accidentally writing to your hard-drives and ensures every byte of data was written correctly.",
  "homepage": "https://hexos.com",
  "repository": {
    "type": "git",
    "url": "git@github.com:eshtek/etcher.git"
  },
  "scripts": {
    "prettify": "prettier --write lib/**/*.css && balena-lint --fix --typescript typings lib tests forge.config.ts forge.sidecar.ts native-arch.ts macos-min.ts webpack.config.ts",
    "lint": "npm run prettify && catch-uncommitted",
    "test": "echo 'Only use custom tests; if you want to test locally, use `npm run wdio`' && exit 0",
    "package": "electron-forge package",
    "start": "electron-forge start",
    "make": "electron-forge make",
    "wdio": "xvfb-maybe wdio run ./wdio.conf.ts"
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm run prettify"
    }
  },
